{
  "name": "@ton-community/tlb-runtime",
  "version": "1.0.0-alpha.5",
  "description": "TL‑B Runtime is a library for parsing and (de)serializing data according to TL‑B schemas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "prettier": "@ton/toolchain/prettier",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "qa": "yarn build && yarn lint && yarn test --coverage",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "fmt": "prettier --write -l --cache .",
    "fmt:check": "prettier --check --cache ."
  },
  "keywords": [
    "ton",
    "blockchain",
    "tl-b",
    "runtime",
    "typescript"
  ],
  "author": "TON Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ton-community/tlb-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/ton-community/tlb-runtime/issues"
  },
  "homepage": "https://github.com/ton-community/tlb-runtime#readme",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@ton/core": "^0.63.0",
    "@ton/toolchain": "github:the-ton-tech/toolchain#v1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ton-community/tlb-codegen": "2.0.0-beta.3",
    "@ton-community/tlb-parser": "^0.1.5",
    "@ton/crypto": "^3.3.0",
    "tlb-parser-v2": "npm:@ton-community/tlb-parser@^0.2.1"
  },
  "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae",
  "peerDependencies": {
    "@ton/core": "^0.60.1 || ^0.61.0 || ^0.63.0"
  }
}
